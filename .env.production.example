# Production / remote-deploy env for diaflow-teammate-mcp (Docker, service-credential mode).
# Copy to `.env` and fill in. NEVER commit the real .env.

# --- Transport (container deploy = HTTP; Docker image defaults MCP_TRANSPORT=http) ---
MCP_TRANSPORT=http
# Local listen port. Most hosts inject $PORT instead, which takes precedence.
MCP_HTTP_PORT=8787

# --- Public URL Diaflow will call (MUST be https, public, non-private host) ---
# The value you register as the custom-MCP resource URL; include the /mcp path.
MCP_PUBLIC_URL=https://your-mcp-host.example.com/mcp

# --- Inbound auth (REQUIRED for a public deploy) ---
# Long random secret. Diaflow sends it as `Authorization: Bearer <this>` to /mcp.
# Without it the endpoint is UNAUTHENTICATED and register_self_as_custom_mcp refuses to run.
MCP_INBOUND_TOKEN=replace-with-a-long-random-secret

# --- Diaflow backend ---
DIAFLOW_API_BASE=https://api.diaflow.io

# --- Outbound service credential (non-interactive teammate-runtime auth) ---
# A WorkOS sealed session obtained for the service account (the `session` field from
# POST /api/v1/auth/magic-auth/verify). Sealed sessions EXPIRE — see DEPLOY.md for the
# refresh/re-seed strategy. Required so the server can call Diaflow without a human login.
DIAFLOW_TOKEN=
# The workspace this service identity operates in.
DIAFLOW_WORKSPACE_ID=

# --- Auth mode ---
# Auth mode: "static" (single service seal + MCP_INBOUND_TOKEN gate) or
# "oauth" (per-user login via Diaflow magic code; required for Diaflow's paste-URL Connect).
MCP_AUTH_MODE=oauth
# oauth mode REQUIRES a public https URL ending in /mcp (issuer = its origin, resource = full URL).
MCP_PUBLIC_URL=https://teammate-mcp.onrender.com/mcp
# In oauth mode, DIAFLOW_TOKEN / MCP_INBOUND_TOKEN are ignored.
